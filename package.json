{
  "name": "@gorlikitsme/nosbot.js",
  "version": "0.0.13",
  "description": "A node.js library for building Nostale Bot",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "GorlikItsMe",
  "license": "MIT",
  "keywords": [
    "nostale",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gorlikitsme/nosbot.js.git"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "npm run build:source && npm run build:declarations",
    "build:source": "rimraf dist/ && tsc -p tsconfig.json",
    "build:declarations": "rimraf declarations/ && tsc -p tsconfig.json --declaration --declarationMap --declarationDir declarations/",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run lint && npm run build",
    "test:e2e": "node test-server/orchestrator.mjs e2e",
    "server:up": "node test-server/orchestrator.mjs up",
    "server:down": "node test-server/orchestrator.mjs down",
    "server:seed": "node test-server/orchestrator.mjs seed",
    "server:data": "node test-server/orchestrator.mjs data"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^4.9.1",
    "@typescript-eslint/parser": "^4.9.1",
    "eslint": "^7.15.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier": "^3.2.0",
    "pg": "^8.22.0",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "openssl": "^2.0.0",
    "pngjs": "^7.0.0",
    "promise-socket": "^7.0.0",
    "wait-for-event": "^2.0.1",
    "winston": "^3.8.2"
  }
}
